{% set pkField = primaryKey[0] ?? 'id' %}
    /**
     * Delete method
     *
     * @param string|null $id {{ singularHumanName }} id.
     * @return \Cake\Http\Response|null Redirects to index.
     * @throws \Cake\Datasource\Exception\RecordNotFoundException When record not found.
     */
    public function delete($id = null)
    {
        $this->getRequest()->allowMethod(['post', 'delete']);
        
        $table = $this->fetchTable('{{ currentModelName }}');
        ${{ singularName }} = $table->get($id);
{% if Bake.hasPlugin('Authorization') %}
        $this->Authorization->authorize(${{ singularName }});
{% endif %}

        $session = $this->getRequest()->getSession();
        $session->delete('LastViewed.{{ singularName }}_id');

        // Törlés utáni visszagörgetés: megkeressük a közvetlenül előtte lévő rekordot
        $neighbor = $table->find()
            ->select(['{{ pkField }}'])
            ->where(['{{ pkField }} <' => (int)$id])
            ->orderByDesc('{{ pkField }}')
            ->first();

        // Ha nincs előtte lévő rekord (első volt), megpróbáljuk a következőt keresni
        if (!$neighbor) {
            $neighbor = $table->find()
                ->select(['{{ pkField }}'])
                ->where(['{{ pkField }} >' => (int)$id])
                ->orderByAsc('{{ pkField }}')
                ->first();
        }

        if ($neighbor) {
            $session->write('ScrollTo.{{ singularName }}_id', (int)$neighbor->{{ pkField }});
        } else {
            $session->delete('ScrollTo.{{ singularName }}_id');
        }

        if ($table->delete(${{ singularName }})) {
            $this->Flash->success({% if plugin %}__d('{{ plugin }}', {% else %}__({% endif %}'A(z) {{ singularHumanName|lower }} sikeresen törölve lett.'));
        } else {
            $this->Flash->error({% if plugin %}__d('{{ plugin }}', {% else %}__({% endif %}'A törlés sikertelen. Kérjük, próbálja újra.'));
        }

        $redirectParams = (array)$session->read('Paging.{{ currentModelName }}.params');

        return $this->redirect([
            'action' => 'index',
            '?' => $redirectParams,
        ]);
    }